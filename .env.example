# Jev POC — environment template. Copy to .env and fill in.
#
# Get an OpenRouter key: https://openrouter.ai/settings/keys
# With no key set, the app runs in fixture mode: every demo replays a seeded
# response and badges itself as such. Nothing calls the network.
OPENROUTER_API_KEY=

# Jev on OpenRouter. `typesafe/jev-1.13-20260917` is the pinned build.
JEV_MODEL=typesafe/jev-1.13

# OpenRouter serves decision models on a dedicated endpoint, NOT
# /chat/completions. This path is still on /api/alpha/ and may move; override
# it here if it does, without a code change.
JEV_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions

# Hono server port. Local development uses 8787; the container image sets 8080.
PORT=8787

# The assessment baseline (`pnpm capture:baseline`) uses this key on its default
# `openrouter` backend. Its `--backend cli` mode needs no key — it runs the local
# `claude` CLI instead — and `pnpm assess` always uses the CLI, never this key.
